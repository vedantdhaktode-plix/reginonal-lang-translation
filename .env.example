# Service A uses Gemini Vision for OCR and Groq for text translation.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
TRANSLATION_PROVIDER=groq
TRANSLATION_MODEL=openai/gpt-oss-20b
TRANSLATION_BATCH_SIZE=12

# Optional provider: set TRANSLATION_PROVIDER=claude.
# Groq is used for text translation and AI review; Gemini handles video OCR.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OCR_PROVIDER=gemini
OCR_TARGET_BOX=agent

# Optional OpenAI transcription. Empty key uses local faster-whisper automatically.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Required by Service B's audio dubbing stage
ELEVENLABS_API_KEY=
# Optional: force a specific native target-language voice. HI_TTS_VOICE_ID
# takes precedence for Hindi; TARGET_TTS_VOICE_ID is the generic fallback.
TARGET_TTS_VOICE_ID=
HI_TTS_VOICE_ID=
# Marathi preserves the original speaker by default. Set this only when a
# replacement Marathi voice (for example, a selected female voice) is wanted.
MR_TTS_VOICE_ID=
SYNC_API_KEY=
HF_TOKEN=

# Optional settings
PIPELINE_DATA_DIR=/data
PIPELINE_MAX_UPLOAD_BYTES=2147483648
PIPELINE_SOURCE_LANGUAGE=auto
HF_LIPSYNC_SPACE=fffiloni/LatentSync
SYNC_MODEL=lipsync-2
LIPSYNC_CLASSIFY_WINDOW_SEC=0.5
LIPSYNC_MAX_HEAD_YAW_DEG=28
LIPSYNC_MAX_HEAD_PITCH_DEG=20
LIPSYNC_MAX_AWAY_FACE_RATIO=0.4
